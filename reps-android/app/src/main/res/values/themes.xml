<resources>
    <style name="Theme.REPS" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0B0B0C</item>
        <item name="android:colorBackground">#0B0B0C</item>
        <item name="android:statusBarColor">#0B0B0C</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#F2F0EA</item>
        <item name="android:textColorSecondary">#8A8A92</item>
        <item name="android:textColorHint">#5C5C64</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Label">
        <item name="android:textColor">#5C5C64</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="BigBtn">
        <item name="android:background">@drawable/bg_acc</item>
        <item name="android:textColor">#0B0B0C</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SqBtn">
        <item name="android:background">@drawable/bg_sq</item>
        <item name="android:textColor">#F2F0EA</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">#8A8A92</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
</resources>
